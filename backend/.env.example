# Delta Banglore CRM — backend
#
# Copy to .env and fill in. Values here are placeholders, never real
# credentials: the real file is gitignored and stays that way.
#
# Only the three under "Required" have no working default. Everything else runs
# without being set — the feature it belongs to is simply off. The exception is
# R2, which is required in practice: see the note there.

# ── Required ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/crm
JWT_SECRET=change-me-to-something-long-and-random
JWT_REFRESH_SECRET=change-me-to-something-else-long-and-random

# ── Where it runs ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Root portal ───────────────────────────────────────────────────────────────
ROOT_ERP_SECRET=

# ── Object storage (Cloudflare R2) ────────────────────────────────────────────
#
# Payment receipts taken when a lead is closed. The same values and bucket
# Delta Finance uses: the handover carries the key and finance attaches the
# very file this wrote.
#
# Required in practice: a receipt is mandatory at the close, so without these
# nobody can close a lead (the upload says so plainly).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=delta-uploads
# The public base URL the bucket is served from.
R2_PUBLIC_URL=

# ── Handover to Delta Finance ─────────────────────────────────────────────────
#
# On only when every field is set. Enrolments go to Banglore's finance
# organisation, which keeps its books in INR — amounts are sent as INR, never
# converted. They are tagged crm "banglore".
#
# FINANCE_CLIENT_ID and FINANCE_INTEGRATION_SECRET must match INBOUND_CLIENT_ID
# and INBOUND_INTEGRATION_SECRET on the finance side.
FINANCE_API_URL=
FINANCE_CLIENT_ID=crm
FINANCE_INTEGRATION_SECRET=
# Banglore's organization id in finance.
FINANCE_ORG_ID=

# ── Delta LMS (optional) ──────────────────────────────────────────────────────
# Only for the course list on the Courses page's "Map". Empty uses the public
# Delta LMS address.
LMS_API_URL=

# ── Scheduled jobs ────────────────────────────────────────────────────────────
#
# Reminders, the lead split and backups. On in exactly one process: set false
# on a local copy pointed at a real database. The finance handover is not
# affected by this.
RUN_SCHEDULERS=true

# ── Web push notifications ────────────────────────────────────────────────────
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# ── Optional integrations ─────────────────────────────────────────────────────
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CALL_RECORDER_API_KEY=

# ── First run only ────────────────────────────────────────────────────────────
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@your-domain.com
SUPER_ADMIN_PASSWORD=ChangeMe@123
